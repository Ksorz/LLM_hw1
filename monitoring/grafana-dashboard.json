{
  "title": "LLM Service Overview",
  "panels": [
    {
      "type": "graph",
      "title": "HTTP request rate",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (handler,method,status)",
          "legendFormat": "{{handler}} {{method}} {{status}}"
        }
      ]
    },
    {
      "type": "graph",
      "title": "HTTP latency p50/p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le,handler))",
          "legendFormat": "p50 {{handler}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le,handler))",
          "legendFormat": "p95 {{handler}}"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Error rate (5xx/4xx)",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..\"}[5m]))",
          "legendFormat": "4xx"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "version": 1
}


